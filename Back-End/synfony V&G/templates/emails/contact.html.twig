{% extends 'emails/base.html.twig' %}
{% block contenu %}
    <h1 style="font-size:20px;margin-top:0;">Nouvelle demande de contact</h1>
    <p><strong>De :</strong> <a href="mailto:{{ emailVisiteur }}">{{ emailVisiteur }}</a></p>
    <p><strong>Titre :</strong> {{ titre }}</p>
    <div style="background:#f6f1ea;padding:12px 16px;border-radius:6px;">{{ description|nl2br }}</div>
    <p style="font-size:13px;color:#6b6b6b;">Répondez directement à ce mail pour répondre au visiteur.</p>
{% endblock %}
