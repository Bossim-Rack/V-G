{% extends 'emails/base.html.twig' %}
{% block contenu %}
    <h1 style="font-size:20px;margin-top:0;">Réinitialisation de votre mot de passe</h1>
    <p>Bonjour {{ user.firstName }},</p>
    <p>Vous avez demandé à réinitialiser le mot de passe de votre compte. Cliquez sur le bouton ci-dessous pour en choisir un nouveau :</p>
    {% include 'emails/_bouton.html.twig' with {lien: lien, texte: 'Choisir un nouveau mot de passe'} %}
    <p style="font-size:13px;color:#6b6b6b;">Ce lien est valable <strong>1 heure</strong> et ne peut servir qu'une seule fois. Si vous n'avez rien demandé, ignorez ce message : votre mot de passe actuel reste inchangé.</p>
{% endblock %}
