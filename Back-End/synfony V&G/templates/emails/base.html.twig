<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block titre %}Vite & Gourmand{% endblock %}</title>
</head>
<body style="margin:0;padding:0;background:#f6f1ea;font-family:Arial,Helvetica,sans-serif;color:#2b2b2b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f1ea;padding:24px 0;">
    <tr>
        <td align="center">
            <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">
                <tr>
                    <td style="background:#3d4a3a;color:#ffffff;padding:20px 32px;font-size:22px;font-weight:bold;">
                        Vite <span style="color:#e3b04b;">&amp;</span> Gourmand
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;font-size:15px;line-height:1.6;">
                        {% block contenu %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="background:#f0ebe3;padding:16px 32px;font-size:12px;color:#6b6b6b;">
                        Vite &amp; Gourmand - Traiteur à Bordeaux depuis 25 ans.<br>
                        Ce message a été envoyé automatiquement, merci de ne pas y répondre directement.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
